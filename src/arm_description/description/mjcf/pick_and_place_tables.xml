<mujoco model="ur5e pick and place (tables)">
  <!-- Pick-and-place on tables. Layout:
         - robot_table: pedestal under the robot
         - pick_table:  in front (+y), holds the objects
         - drop_table:  to the right (+x), empty, for placing picked objects

       All three table tops are at z=0, which is the robot's mounting height (the UR5e base
       is fixed at world z=0 in ur5e.xml). The ground plane is dropped to z=-0.5 so the
       tables read as raised surfaces. Because z=0 is unchanged, the arm's reach geometry is
       identical to the floor scene; the tables simply sit inside the ~0.85 m UR5e reach.

       This file includes ur5e.xml directly (not scene.xml) so it can place its own lowered
       floor, and re-declares the scene visuals and the eye-to-hand camera. Reset to the
       "start" keyframe (from objects.xml). -->
  <include file="ur5e.xml"/>

  <statistic center="0.3 0.3 0.2" extent="1.1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_top" rgba="0.62 0.46 0.30 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.0" dir="0 0 -1" directional="true"/>
    <geom name="floor" pos="0 0 -0.5" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Eye-to-hand (static) overview camera, aimed at the workspace centre. -->
    <camera name="scene_rgbd" pos="0.75 1.05 0.75" fovy="55"
      xyaxes="-0.591 0.806 0 -0.452 -0.332 0.828"/>

    <!-- Tables: static boxes from the floor (z=-0.5) up to z=0. -->
    <geom name="robot_table" type="box" pos="0 0 -0.25" size="0.22 0.22 0.25" material="table_top"/>
    <geom name="pick_table" type="box" pos="0 0.55 -0.25" size="0.35 0.25 0.25" material="table_top"/>
    <geom name="drop_table" type="box" pos="0.60 0.15 -0.25" size="0.25 0.30 0.25" material="table_top"/>
  </worldbody>

  <!-- Objects sit on the pick table (its top is at z=0, same as the floor scene). -->
  <include file="objects.xml"/>
</mujoco>

<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">
  <xacro:arg name="name" default="mobile_arm"/>
  <xacro:arg name="ur_type" default="ur5e"/>
  <xacro:arg name="arm_prefix" default="arm_"/>
  <xacro:arg name="joint_limit_params" default="$(find arm_description)/config/$(arg ur_type)/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params" default="$(find arm_description)/config/$(arg ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_params" default="$(find arm_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params" default="$(find arm_description)/config/$(arg ur_type)/visual_parameters.yaml"/>
  <xacro:arg name="safety_limits" default="true"/>
  <xacro:arg name="safety_pos_margin" default="0.15"/>
  <xacro:arg name="safety_k_position" default="20"/>
  <xacro:arg name="force_abs_paths" default="true"/>
  <xacro:arg name="initial_positions_file" default="$(find arm_description)/config/initial_positions.yaml"/>
  <xacro:arg name="controllers_file" default="$(find arm_ros2_control)/config/controllers.yaml"/>
  <xacro:arg name="control_robot_param" default="robot_description"/>
  <xacro:arg name="control_robot_param_node" default="robot_description_control_server"/>
  <xacro:arg name="use_ros2_control" default="false"/>
  <xacro:arg name="gripper_prefix" default="robotiq_"/>
  <xacro:arg name="include_gz_camera_sensors" default="false"/>

  <xacro:include filename="$(find mobile_arm_description)/urdf/diff_base.xacro"/>
  <xacro:include filename="$(find arm_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find arm_description)/urdf/ros2_control_gz.xacro"/>
  <xacro:include filename="$(find arm_description)/urdf/robotiq_3f_mount.xacro"/>
  <xacro:include filename="$(find arm_description)/urdf/realsense_d435i_mount.xacro"/>

  <xacro:property name="initial_positions_file" default="$(arg initial_positions_file)"/>

  <xacro:mobile_diff_base/>

  <xacro:ur_robot
    name="$(arg name)"
    tf_prefix="$(arg arm_prefix)"
    parent="base_top_link"
    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)"
    safety_limits="$(arg safety_limits)"
    safety_pos_margin="$(arg safety_pos_margin)"
    safety_k_position="$(arg safety_k_position)"
    force_abs_paths="$(arg force_abs_paths)"
    >
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </xacro:ur_robot>

  <xacro:robotiq_3f_mount parent="$(arg arm_prefix)tool0" prefix="$(arg arm_prefix)$(arg gripper_prefix)">
    <origin xyz="0 0 0.045" rpy="1.5708 0 0"/>
  </xacro:robotiq_3f_mount>

  <xacro:realsense_d435i_mount parent="$(arg arm_prefix)$(arg gripper_prefix)palm" name="$(arg arm_prefix)wrist_camera">
    <origin xyz="-0.020 0.030 0.070" rpy="0 0 ${pi/2}"/>
  </xacro:realsense_d435i_mount>

  <gazebo>
    <self_collide>true</self_collide>
  </gazebo>

  <xacro:if value="$(arg use_ros2_control)">
    <xacro:ur_gz_ros2_control
      name="$(arg name)"
      tf_prefix="$(arg arm_prefix)"
      gripper_prefix="$(arg gripper_prefix)"
      initial_positions="${xacro.load_yaml(initial_positions_file)}"
    />

    <gazebo>
      <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg controllers_file)</parameters>
        <robot_param>$(arg control_robot_param)</robot_param>
        <robot_param_node>$(arg control_robot_param_node)</robot_param_node>
      </plugin>
    </gazebo>
  </xacro:if>

  <xacro:if value="$(arg include_gz_camera_sensors)">
    <xacro:realsense_d435i_gz_sensors name="$(arg arm_prefix)wrist_camera"/>
  </xacro:if>
</robot>

<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${mass * (y * y + z * z) / 12.0}"
        ixy="0"
        ixz="0"
        iyy="${mass * (x * x + z * z) / 12.0}"
        iyz="0"
        izz="${mass * (x * x + y * y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertial_z" params="mass radius length">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${mass * (3.0 * radius * radius + length * length) / 12.0}"
        ixy="0"
        ixz="0"
        iyy="${mass * (3.0 * radius * radius + length * length) / 12.0}"
        iyz="0"
        izz="${mass * radius * radius / 2.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="mobile_diff_base" params="
    prefix:=''
    base_length:=0.90
    base_width:=0.62
    base_height:=0.28
    base_mass:=70.0
    base_top_mass:=12.0
    ground_clearance:=0.04
    wheel_radius:=0.12
    wheel_width:=0.06
    wheel_mass:=3.0
    wheel_base:=0.56
    wheel_separation:=0.68
    lidar_radius:=0.055
    lidar_height:=0.08
    ">

    <material name="${prefix}dark_gray">
      <color rgba="0.12 0.13 0.14 1.0"/>
    </material>
    <material name="${prefix}blue">
      <color rgba="0.05 0.28 0.58 1.0"/>
    </material>
    <material name="${prefix}black">
      <color rgba="0.02 0.02 0.02 1.0"/>
    </material>

    <link name="${prefix}base_footprint"/>

    <link name="${prefix}base_link">
      <visual>
        <origin xyz="0 0 ${wheel_radius + ground_clearance + base_height / 2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${base_length} ${base_width} ${base_height}"/>
        </geometry>
        <material name="${prefix}blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${wheel_radius + ground_clearance + base_height / 2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${base_length} ${base_width} ${base_height}"/>
        </geometry>
      </collision>
      <xacro:box_inertial mass="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
    </link>

    <joint name="${prefix}base_footprint_joint" type="fixed">
      <parent link="${prefix}base_footprint"/>
      <child link="${prefix}base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}base_top_link">
      <visual>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <geometry>
          <box size="0.42 0.42 0.05"/>
        </geometry>
        <material name="${prefix}dark_gray"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <geometry>
          <box size="0.42 0.42 0.05"/>
        </geometry>
      </collision>
      <xacro:box_inertial mass="${base_top_mass}" x="0.42" y="0.42" z="0.05"/>
    </link>

    <joint name="${prefix}base_top_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}base_top_link"/>
      <origin xyz="0 0 ${wheel_radius + ground_clearance + base_height}" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}lidar_link">
      <visual>
        <origin xyz="0 0 ${lidar_height / 2.0}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
        </geometry>
        <material name="${prefix}dark_gray"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${lidar_height / 2.0}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertial_z mass="0.4" radius="${lidar_radius}" length="${lidar_height}"/>
    </link>

    <joint name="${prefix}lidar_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}lidar_link"/>
      <origin xyz="0.32 0 ${wheel_radius + ground_clearance + base_height + 0.05}" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}front_left_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="${prefix}black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertial_z mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}"/>
    </link>

    <link name="${prefix}front_right_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="${prefix}black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertial_z mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}"/>
    </link>

    <link name="${prefix}rear_left_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="${prefix}black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertial_z mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}"/>
    </link>

    <link name="${prefix}rear_right_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="${prefix}black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertial_z mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}"/>
    </link>

    <joint name="${prefix}front_left_wheel_joint" type="continuous">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}front_left_wheel_link"/>
      <origin xyz="${wheel_base / 2.0} ${wheel_separation / 2.0} ${wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.02"/>
    </joint>

    <joint name="${prefix}front_right_wheel_joint" type="continuous">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}front_right_wheel_link"/>
      <origin xyz="${wheel_base / 2.0} ${-wheel_separation / 2.0} ${wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.02"/>
    </joint>

    <joint name="${prefix}rear_left_wheel_joint" type="continuous">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}rear_left_wheel_link"/>
      <origin xyz="${-wheel_base / 2.0} ${wheel_separation / 2.0} ${wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.02"/>
    </joint>

    <joint name="${prefix}rear_right_wheel_joint" type="continuous">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}rear_right_wheel_link"/>
      <origin xyz="${-wheel_base / 2.0} ${-wheel_separation / 2.0} ${wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.02"/>
    </joint>

    <gazebo reference="${prefix}base_link">
      <material>Gazebo/Blue</material>
      <self_collide>true</self_collide>
      <gravity>true</gravity>
    </gazebo>
    <gazebo reference="${prefix}base_top_link">
      <material>Gazebo/DarkGrey</material>
      <self_collide>true</self_collide>
    </gazebo>
    <gazebo reference="${prefix}lidar_link">
      <material>Gazebo/DarkGrey</material>
      <sensor name="${prefix}lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>scan</topic>
        <gz_frame_id>${prefix}lidar_link</gz_frame_id>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <always_on>true</always_on>
        <visualize>false</visualize>
      </sensor>
    </gazebo>
    <gazebo reference="${prefix}front_left_wheel_link">
      <material>Gazebo/Black</material>
      <self_collide>false</self_collide>
      <mu1>8.0</mu1>
      <mu2>0.4</mu2>
      <kp>1000000.0</kp>
      <kd>50.0</kd>
    </gazebo>
    <gazebo reference="${prefix}front_right_wheel_link">
      <material>Gazebo/Black</material>
      <self_collide>false</self_collide>
      <mu1>8.0</mu1>
      <mu2>0.4</mu2>
      <kp>1000000.0</kp>
      <kd>50.0</kd>
    </gazebo>
    <gazebo reference="${prefix}rear_left_wheel_link">
      <material>Gazebo/Black</material>
      <self_collide>false</self_collide>
      <mu1>8.0</mu1>
      <mu2>0.4</mu2>
      <kp>1000000.0</kp>
      <kd>50.0</kd>
    </gazebo>
    <gazebo reference="${prefix}rear_right_wheel_link">
      <material>Gazebo/Black</material>
      <self_collide>false</self_collide>
      <mu1>8.0</mu1>
      <mu2>0.4</mu2>
      <kp>1000000.0</kp>
      <kd>50.0</kd>
    </gazebo>

    <gazebo>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>${prefix}rear_left_wheel_joint</left_joint>
        <right_joint>${prefix}rear_right_wheel_joint</right_joint>
        <wheel_separation>${wheel_separation}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <max_linear_acceleration>4.0</max_linear_acceleration>
        <min_linear_acceleration>-8.0</min_linear_acceleration>
        <max_angular_acceleration>5.0</max_angular_acceleration>
        <min_angular_acceleration>-10.0</min_angular_acceleration>
        <max_linear_velocity>1.0</max_linear_velocity>
        <min_linear_velocity>-0.5</min_linear_velocity>
        <max_angular_velocity>1.0</max_angular_velocity>
        <min_angular_velocity>-1.0</min_angular_velocity>
        <odom_publish_frequency>50</odom_publish_frequency>
        <topic>cmd_vel</topic>
        <odom_topic>odom</odom_topic>
        <tf_topic>tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>${prefix}base_footprint</child_frame_id>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
